# All variables are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.
# Copy to .env.local (production project) or .env.test (invite-test project). Never commit real values.

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Supabase secret (service-role) key. Bypasses RLS; server code only.
SUPABASE_SECRET_KEY=
# Postgres connection string, used only by `pnpm db:migrate` (not read at runtime).
SUPABASE_DB_URL=
# Random string used to hash client IPs for rate limiting (e.g. `openssl rand -hex 32`).
RATE_LIMIT_SALT=
# Random string; Vercel cron sends it as `Authorization: Bearer ...` to /api/health.
CRON_SECRET=

# Optional rate-limit overrides (defaults: page 30 / 10 min per IP, api 60 / 10 min per code+IP,
# crawler 300 / 10 min per IP). Raise them in .env.test so e2e runs do not hit 429.
# RATE_LIMIT_PAGE_MAX=30
# RATE_LIMIT_API_MAX=60
# RATE_LIMIT_CRAWLER_MAX=300
